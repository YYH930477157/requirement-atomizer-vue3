{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratomizer.local/schemas/extraction_unit.schema.json",
  "title": "Extraction unit v1",
  "type": "object",
  "required": [
    "schema", "unit_id", "unit_kind", "source_text", "source_text_hash",
    "clause_path", "source_block_ids", "roles", "context_refs",
    "planner_version", "locator"
  ],
  "properties": {
    "schema": {"const": "extraction-unit/v1"},
    "unit_id": {"type": "string", "minLength": 1},
    "unit_kind": {
      "enum": [
        "clause_segment", "narrative", "heading", "table_row", "table_cell",
        "definition", "reference"
      ]
    },
    "source_text": {"type": "string", "minLength": 1},
    "source_text_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "clause_path": {"type": "array", "items": {"type": "string"}},
    "source_block_ids": {"type": "array", "items": {"type": "string"}},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "requirement_candidate", "review_candidate", "context", "excluded",
          "list_item", "cosem_structured"
        ]
      }
    },
    "context_refs": {"type": "array", "items": {"type": "string"}},
    "planner_version": {"type": "string", "minLength": 1},
    "sentence_index": {"type": "integer", "minimum": 0},
    "covers_cell_ids": {"type": "array", "items": {"type": "string"}},
    "table_context": {
      "type": "object",
      "required": ["table_id", "row_index", "headers"],
      "properties": {
        "table_id": {"type": "string", "minLength": 1},
        "item_id": {"type": "string"},
        "cell_id": {"type": "string"},
        "row_index": {"type": "integer", "minimum": 0},
        "column_index": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "headers": {"type": "array", "items": {"type": "string"}},
        "structural_role": {"type": "string"},
        "disposition": {
          "oneOf": [
            {"enum": ["target", "context", "composite", "excluded", "review"]},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "locator": {
      "type": "object",
      "required": ["source_type", "source_id"],
      "properties": {
        "source_type": {
          "enum": [
            "block", "block_sentence", "table_row", "table_cell",
            "definition", "reference"
          ]
        },
        "source_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
