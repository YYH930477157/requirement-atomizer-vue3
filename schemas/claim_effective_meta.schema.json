{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratomizer.local/schemas/claim_effective_meta.schema.json",
  "title": "Claim effective snapshot meta v1",
  "type": "object",
  "required": [
    "schema", "artifact_protocol_version", "effective_artifact_version",
    "effective_snapshot_version", "run_id", "committed_at",
    "base_generation_id", "document_generation_id", "catalog_generation_id",
    "generation_meta_sha256", "base_ledger_sha256", "effective_ledger_sha256",
    "queue_sha256", "queue_count", "ledger_count", "claim_events_enabled",
    "event_prefix_sha256", "last_event_seq", "document_effective_revision",
    "target_set_hash", "target_publication_revision", "requirement_review_state_hash",
    "effective_ledger_schema", "review_adapter_versions", "reducer_version",
    "bridge_version", "queue_version", "effective_metrics", "versions"
  ],
  "properties": {
    "schema": {"const": "claim-effective-meta/v1"},
    "artifact_protocol_version": {"const": "claim-effective-artifacts-v1"},
    "effective_artifact_version": {"const": "claim-effective-artifacts-v1"},
    "effective_snapshot_version": {"const": "claim-effective-snapshot-v2"},
    "run_id": {"type": "string"},
    "committed_at": {"type": "string", "format": "date-time"},
    "base_generation_id": {"$ref": "#/$defs/hash"},
    "document_generation_id": {"$ref": "#/$defs/hash"},
    "catalog_generation_id": {"$ref": "#/$defs/hash"},
    "generation_meta_sha256": {"$ref": "#/$defs/hash"},
    "base_ledger_sha256": {"$ref": "#/$defs/hash"},
    "effective_ledger_sha256": {"$ref": "#/$defs/hash"},
    "queue_sha256": {"$ref": "#/$defs/hash"},
    "queue_count": {"type": "integer", "minimum": 0},
    "ledger_count": {"type": "integer", "minimum": 0},
    "claim_events_enabled": {"const": true},
    "event_prefix_sha256": {"$ref": "#/$defs/hash"},
    "last_event_seq": {"type": "integer", "minimum": 0},
    "document_effective_revision": {"$ref": "#/$defs/hash"},
    "target_set_hash": {"$ref": "#/$defs/hash"},
    "target_publication_revision": {"$ref": "#/$defs/hash"},
    "requirement_review_state_hash": {"$ref": "#/$defs/hash"},
    "effective_ledger_schema": {"const": "claim-effective-ledger/v1"},
    "review_adapter_versions": {
      "type": "array",
      "items": {"$ref": "#/$defs/review_adapter_version"},
      "minItems": 1,
      "uniqueItems": true
    },
    "reducer_version": {"type": "string", "minLength": 1},
    "bridge_version": {"type": "string", "minLength": 1},
    "queue_version": {"type": "string", "minLength": 1},
    "effective_metrics": {"type": "object"},
    "versions": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "review_adapter_version": {
      "type": "object",
      "required": ["target_kind", "adapter_version"],
      "properties": {
        "target_kind": {"enum": ["ai_requirement", "atomic_requirement"]},
        "adapter_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
