{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc-map/v1",
  "title": "Document map (V3 WS-A A1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "prompt_version",
    "provenance",
    "status",
    "route_requested",
    "route",
    "fingerprint",
    "content_fingerprint",
    "clause_count",
    "scaffold",
    "llm_annotations"
  ],
  "properties": {
    "schema_version": {"const": "doc-map/v1"},
    "producer": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "provenance": {"type": "object"},
    "status": {"const": "ok"},
    "route_requested": {"type": "string"},
    "route": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "minLength": 1},
    "content_fingerprint": {"type": "string", "minLength": 1},
    "clause_count": {"type": "integer", "minimum": 0},
    "scaffold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skeleton", "clause_block_map", "table_families", "density_hotspots"],
      "properties": {
        "skeleton": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section_id", "heading", "section_path", "clause_family", "char_count", "block_count"],
            "properties": {
              "section_id": {"type": "string"},
              "heading": {"type": "string"},
              "section_path": {"type": "array", "items": {"type": "string"}},
              "clause_family": {"type": ["string", "null"]},
              "char_count": {"type": "integer", "minimum": 0},
              "block_count": {"type": "integer", "minimum": 0}
            }
          }
        },
        "clause_block_map": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section_id", "block_ids"],
            "properties": {
              "section_id": {"type": "string"},
              "block_ids": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "table_families": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["block_id", "table_id", "headers", "family_id", "match_score"],
            "properties": {
              "block_id": {"type": "string"},
              "table_id": {"type": "string"},
              "headers": {"type": "array", "items": {"type": "string"}},
              "family_id": {"type": "string"},
              "match_score": {"type": "integer"}
            }
          }
        },
        "density_hotspots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chapter", "requirement_like_blocks", "total_blocks", "density"],
            "properties": {
              "chapter": {"type": "string"},
              "requirement_like_blocks": {"type": "integer", "minimum": 0},
              "total_blocks": {"type": "integer", "minimum": 0},
              "density": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "llm_annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_type", "domains", "hotspot_rationale", "notes", "rejected_codes"],
      "properties": {
        "document_type": {"type": "string", "minLength": 1},
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "section_ids", "summary"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "section_ids": {"type": "array", "items": {"type": "string"}},
              "summary": {"type": "string"}
            }
          }
        },
        "hotspot_rationale": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chapter", "rationale"],
            "properties": {
              "chapter": {"type": "string", "minLength": 1},
              "rationale": {"type": "string"}
            }
          }
        },
        "notes": {"type": "string"},
        "rejected_codes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "incomplete_inputs": {"type": "boolean"},
    "input_completeness": {"type": "object"}
  }
}
