{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://requirement-atomizer.local/schemas/orchestration_trace.schema.json",
  "title": "Requirement Atomizer orchestration loop trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_version",
    "policy_version",
    "run_id",
    "round",
    "ts",
    "state_digest",
    "candidates",
    "action",
    "decider",
    "reason",
    "budget",
    "result"
  ],
  "properties": {
    "trace_version": {"const": "orchestration-trace-v1"},
    "policy_version": {"const": "orchestration-policy-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "round": {"type": "integer", "minimum": 1},
    "ts": {"type": "string", "format": "date-time"},
    "state_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counts_by_kind",
        "extract_working",
        "extract_total",
        "human_count",
        "verification_candidate_count",
        "addressed_count",
        "ready_gate"
      ],
      "properties": {
        "counts_by_kind": {
          "type": "object",
          "required": [
            "clarification_blocking",
            "conservation_open",
            "sampling_escalate",
            "weakness"
          ],
          "properties": {
            "clarification_blocking": {"type": "integer", "minimum": 0},
            "conservation_open": {"type": "integer", "minimum": 0},
            "sampling_escalate": {"type": "integer", "minimum": 0},
            "weakness": {"type": "integer", "minimum": 0}
          }
        },
        "extract_working": {"type": "integer", "minimum": 0},
        "extract_total": {"type": "integer", "minimum": 0},
        "human_count": {"type": "integer", "minimum": 0},
        "verification_candidate_count": {"type": "integer", "minimum": 0},
        "addressed_count": {"type": "integer", "minimum": 0},
        "ready_gate": {"enum": ["pass", "blocked"]}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "action": {"type": "string", "minLength": 1},
    "decider": {"const": "rule"},
    "reason": {"type": "string", "minLength": 1},
    "gap": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "target_id", "severity", "route", "action"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "target_id": {"type": "string"},
        "severity": {"type": "string"},
        "route": {"type": "string"},
        "action": {"type": "string"},
        "block_id": {"type": "string"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rounds_used", "rounds_max", "llm_authorized"],
      "properties": {
        "rounds_used": {"type": "integer", "minimum": 0},
        "rounds_max": {"type": "integer", "minimum": 1},
        "llm_authorized": {"type": "boolean"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": {"enum": ["ok", "error", "skipped"]},
        "summary": {"type": "string", "minLength": 1}
      }
    }
  }
}
