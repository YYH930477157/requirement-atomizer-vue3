{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://requirement-atomizer.local/schemas/claim_ledger_golden_manifest.schema.json",
  "title": "Claim ledger synthetic golden manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dataset_id",
    "version",
    "created_at",
    "case_count",
    "partition_counts",
    "files",
    "runtime_schemas",
    "baseline_revisions",
    "curation",
    "anonymization",
    "cases"
  ],
  "properties": {
    "schema": {"const": "claim-ledger-golden-manifest/v3"},
    "dataset_id": {"const": "claim_ledger_v1"},
    "version": {"const": "claim-ledger-golden-v4"},
    "created_at": {"type": "string", "format": "date"},
    "case_count": {"type": "integer", "minimum": 1},
    "partition_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "held_out"],
      "properties": {
        "development": {"type": "integer", "minimum": 0},
        "held_out": {"type": "integer", "minimum": 1}
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "expected"],
      "properties": {
        "inputs": {"const": "inputs.json"},
        "expected": {"const": "expected.json"}
      }
    },
    "runtime_schemas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "baseline_revisions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/baseline_revision"}
    },
    "curation": {"$ref": "#/$defs/curation"},
    "anonymization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer_wording_present", "external_assets_present", "source_policy"],
      "properties": {
        "customer_wording_present": {"const": false},
        "external_assets_present": {"const": false},
        "source_policy": {"const": "synthetic_only"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "scenario", "partition", "tuning_eligible"],
      "properties": {
        "case_id": {"$ref": "#/$defs/safe_id"},
        "scenario": {"$ref": "#/$defs/safe_id"},
        "partition": {"enum": ["development", "held_out"]},
        "tuning_eligible": {"type": "boolean"}
      }
    },
    "baseline_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "raw_sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^history/[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$"
        },
        "raw_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_contract_version",
        "prepared_by",
        "human_review_status",
        "reviewed_by",
        "reviewed_at",
        "held_out_adjudications",
        "statement"
      ],
      "properties": {
        "review_contract_version": {"const": "claim-golden-heldout-review-v2"},
        "prepared_by": {"type": "string", "minLength": 1, "maxLength": 120},
        "human_review_status": {"enum": ["pending", "reviewed"]},
        "reviewed_by": {"type": "string", "maxLength": 120},
        "reviewed_at": {"type": "string", "maxLength": 64},
        "held_out_adjudications": {
          "type": "array",
          "items": {"$ref": "#/$defs/adjudication"}
        },
        "statement": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "claim_id",
        "claim_hash",
        "fixture_hash",
        "dimension_verdicts",
        "rationale"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/safe_id"},
        "claim_id": {"type": "string", "pattern": "^CLM-[0-9a-f]{16}$"},
        "claim_hash": {"$ref": "#/$defs/hash"},
        "fixture_hash": {"$ref": "#/$defs/hash"},
        "dimension_verdicts": {"$ref": "#/$defs/dimension_verdicts"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "dimension_verdicts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_boundary",
        "eligibility",
        "resolution",
        "coverage",
        "target_obligation_subject",
        "target_modality",
        "role_object_preservation"
      ],
      "properties": {
        "claim_boundary": {"$ref": "#/$defs/dimension_verdict"},
        "eligibility": {"$ref": "#/$defs/dimension_verdict"},
        "resolution": {"$ref": "#/$defs/dimension_verdict"},
        "coverage": {"$ref": "#/$defs/dimension_verdict"},
        "target_obligation_subject": {"$ref": "#/$defs/dimension_verdict"},
        "target_modality": {"$ref": "#/$defs/dimension_verdict"},
        "role_object_preservation": {"$ref": "#/$defs/dimension_verdict"}
      }
    },
    "dimension_verdict": {
      "enum": ["agree", "disagree", "needs_followup", "not_reviewed"]
    }
  }
}
