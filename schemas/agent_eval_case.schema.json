{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://requirement-atomizer.local/schemas/agent_eval_case.schema.json",
  "title": "Requirement Atomizer agent evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "category", "source", "input", "expected"],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^(classify|grouping|must-ask|hallucination|adjudication-audit|doc-map-coverage)-[0-9]{3}$"
    },
    "category": {
      "enum": ["classify", "grouping", "must_ask", "hallucination", "adjudication_audit", "doc_map_coverage"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_ref", "block_ids", "origin", "curated_by", "curated_at"],
      "properties": {
        "doc_ref": {"type": "string", "minLength": 1},
        "block_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "origin": {"enum": ["real", "anonymized_rewrite"]},
        "curated_by": {"type": "string", "minLength": 1},
        "curated_at": {"type": "string", "format": "date"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "context"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "context": {"type": "string"}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": true
    },
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"category": {"const": "classify"}}},
      "then": {
        "properties": {
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verdict", "rationale", "forbidden", "must_ask_questions"],
            "properties": {
              "verdict": {"enum": ["software", "hardware", "compliance", "non_requirement"]},
              "rationale": {"type": "string", "minLength": 1},
              "forbidden": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "must_ask_questions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"category": {"const": "grouping"}}},
      "then": {
        "properties": {
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verdict", "rationale", "forbidden", "must_ask_questions", "group_key"],
            "properties": {
              "verdict": {"type": "string", "minLength": 1},
              "rationale": {"type": "string", "minLength": 1},
              "forbidden": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "must_ask_questions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "group_key": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"category": {"const": "must_ask"}}},
      "then": {
        "properties": {
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verdict", "rationale", "forbidden", "must_ask_questions"],
            "properties": {
              "verdict": {"type": "string", "minLength": 1},
              "rationale": {"type": "string", "minLength": 1},
              "forbidden": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "must_ask_questions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "detector": {"enum": ["vague_acceptance", "values_left_behind"]}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"category": {"const": "hallucination"}}},
      "then": {
        "properties": {
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verdict", "rationale", "forbidden", "must_ask_questions"],
            "properties": {
              "verdict": {"const": "reject"},
              "rationale": {"type": "string", "minLength": 1},
              "forbidden": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "minItems": 1},
              "must_ask_questions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "detector": {"enum": ["code_drift", "int_drift", "foreign_standard_refs", "opposed_qualifiers"]}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"category": {"const": "adjudication_audit"}}},
      "then": {
        "properties": {
          "expected": {
            "type": "object",
            "additionalProperties": true,
            "required": ["verdict"],
            "properties": {
              "verdict": {"enum": ["accept", "reject"]},
              "adjudication_decision": {"enum": ["accept", "reject"]},
              "rationale": {"type": "string"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"category": {"const": "doc_map_coverage"}}},
      "then": {
        "properties": {
          "expected": {
            "type": "object",
            "additionalProperties": true,
            "required": ["covered_block_ids"],
            "properties": {
              "covered_block_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "mapped_block_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "rationale": {"type": "string"}
            }
          }
        }
      }
    }
  ]
}
