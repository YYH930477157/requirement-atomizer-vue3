{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratomizer.local/schemas/result_package.schema.json",
  "title": "Ratomizer result package v1",
  "type": "object",
  "required": [
    "schema", "layout_version", "package_id", "analysis_status",
    "active_attempt", "last_attempt", "input", "analysis", "workspace",
    "deliverables", "tool", "warnings"
  ],
  "properties": {
    "schema": {"const": "ratomizer-result-package/v1"},
    "layout_version": {"const": "result-layout-v1"},
    "package_id": {"type": "string", "pattern": "^RPK-[0-9a-f]+$"},
    "analysis_status": {"enum": ["running", "incomplete", "completed"]},
    "active_attempt": {"oneOf": [{"$ref": "#/$defs/active_attempt"}, {"type": "null"}]},
    "last_attempt": {"oneOf": [{"$ref": "#/$defs/last_attempt"}, {"type": "null"}]},
    "input": {"$ref": "#/$defs/input"},
    "analysis": {"oneOf": [{"$ref": "#/$defs/analysis"}, {"type": "null"}]},
    "workspace": {"const": ".ratomizer"},
    "deliverables": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "tool": {
      "type": "object",
      "required": ["version", "output_layout_version"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "output_layout_version": {"const": "result-layout-v1"}
      },
      "additionalProperties": false
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "active_attempt": {
      "type": "object",
      "required": ["run_id", "status", "started_at", "requested_stages", "input"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^RUN-[0-9a-f]+$"},
        "status": {"const": "running"},
        "started_at": {"type": "string", "format": "date-time"},
        "requested_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "input": {"$ref": "#/$defs/input"}
      },
      "additionalProperties": false
    },
    "last_attempt": {
      "type": "object",
      "required": ["run_id", "status", "finished_at"],
      "properties": {
        "run_id": {"type": "string"},
        "status": {"enum": ["completed", "failed"]},
        "finished_at": {"type": "string", "format": "date-time"},
        "error": {"type": "string"}
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["display_name", "media_type", "sha256"],
      "properties": {
        "display_name": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "path", "media_type", "bytes", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "required": [
        "run_id", "started_at", "completed_at", "requested_stages",
        "completed_stages", "completion_evidence"
      ],
      "properties": {
        "run_id": {"type": "string"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "requested_stages": {"type": "array", "items": {"type": "string"}},
        "completed_stages": {"type": "array", "items": {"type": "string"}},
        "completion_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["artifact_id", "path", "sha256"],
            "properties": {
              "artifact_id": {"const": "run_manifest_snapshot"},
              "path": {"type": "string"},
              "sha256": {"$ref": "#/$defs/hash"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
