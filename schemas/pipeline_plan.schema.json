{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratomizer.local/schemas/pipeline_plan.schema.json",
  "title": "Ratomizer pipeline plan v2",
  "type": "object",
  "required": [
    "schema", "execution_policy", "delivery", "budget_mode", "stages",
    "contracts_version", "stage_versions", "plan_fingerprint"
  ],
  "properties": {
    "schema": {"const": "ratomizer-pipeline-plan/v2"},
    "execution_policy": {
      "enum": ["quality_first", "force_a", "force_b", "full_dual_audit", "legacy_combined"]
    },
    "delivery": {
      "type": "object",
      "required": [
        "software_requirements", "cosem_spec", "template_workbook",
        "annotation_bundle", "translation_mode"
      ],
      "properties": {
        "software_requirements": {"type": "boolean"},
        "cosem_spec": {"type": "boolean"},
        "template_workbook": {"type": "boolean"},
        "annotation_bundle": {"type": "boolean"},
        "translation_mode": {"enum": ["off", "markers", "full"]}
      },
      "additionalProperties": false
    },
    "budget_mode": {"enum": ["off", "observe", "enforce"]},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "contracts_version": {"type": "string", "minLength": 1},
    "stage_versions": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "plan_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
