{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://requirement-atomizer.local/schemas/claim_shadow_review_decisions.schema.json",
  "title": "Claim shadow review decisions v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dataset_id",
    "reviewed_by",
    "reviewed_at",
    "shadow_adjudications",
    "golden_held_out"
  ],
  "properties": {
    "schema": {"const": "claim-shadow-review-decisions/v3"},
    "dataset_id": {"$ref": "#/$defs/safe_id"},
    "reviewed_by": {"type": "string", "minLength": 1, "maxLength": 120},
    "reviewed_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "shadow_adjudications": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/shadow_adjudication"}
    },
    "golden_held_out": {"$ref": "#/$defs/golden_held_out"}
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "claim_id": {"type": "string", "pattern": "^CLM-[0-9a-f]{16}$"},
    "shadow_adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "claim_id",
        "claim_hash",
        "review_evidence_fingerprint",
        "ledger_resolution",
        "category",
        "verdict",
        "rationale"
      ],
      "properties": {
        "run_id": {"$ref": "#/$defs/safe_id"},
        "claim_id": {"$ref": "#/$defs/claim_id"},
        "claim_hash": {"$ref": "#/$defs/hash"},
        "review_evidence_fingerprint": {"$ref": "#/$defs/hash"},
        "ledger_resolution": {"enum": ["covered", "excluded", "uncertain"]},
        "category": {
          "enum": [
            "semantic_positive",
            "semantic_negative",
            "structural_exclusion",
            "uncertain"
          ]
        },
        "verdict": {"enum": ["agree", "disagree", "needs_followup"]},
        "rationale": {"type": "string", "maxLength": 4000}
      }
    },
    "golden_held_out": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "dataset_version", "adjudications"],
      "properties": {
        "dataset_id": {"const": "claim_ledger_v1"},
        "dataset_version": {"const": "claim-ledger-golden-v4"},
        "adjudications": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/held_out_adjudication"}
        }
      }
    },
    "held_out_adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "claim_id",
        "claim_hash",
        "fixture_hash",
        "dimension_verdicts",
        "rationale"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/safe_id"},
        "claim_id": {"$ref": "#/$defs/claim_id"},
        "claim_hash": {"$ref": "#/$defs/hash"},
        "fixture_hash": {"$ref": "#/$defs/hash"},
        "dimension_verdicts": {"$ref": "#/$defs/dimension_verdicts"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "dimension_verdicts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_boundary",
        "eligibility",
        "resolution",
        "coverage",
        "target_obligation_subject",
        "target_modality",
        "role_object_preservation"
      ],
      "properties": {
        "claim_boundary": {"$ref": "#/$defs/dimension_verdict"},
        "eligibility": {"$ref": "#/$defs/dimension_verdict"},
        "resolution": {"$ref": "#/$defs/dimension_verdict"},
        "coverage": {"$ref": "#/$defs/dimension_verdict"},
        "target_obligation_subject": {"$ref": "#/$defs/dimension_verdict"},
        "target_modality": {"$ref": "#/$defs/dimension_verdict"},
        "role_object_preservation": {"$ref": "#/$defs/dimension_verdict"}
      }
    },
    "dimension_verdict": {
      "enum": ["agree", "disagree", "needs_followup", "not_reviewed"]
    }
  }
}
