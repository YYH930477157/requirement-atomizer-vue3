{
  "name": "requirement-atomizer-desktop-ui",
  "version": "0.1.0",
  "private": true,
  "description": "标准需求抽取与审查平台 Vue3 桌面界面。",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "backend:build": "powershell -ExecutionPolicy Bypass -File ../packaging/build-electron-backend.ps1 -Python ../.venv/Scripts/python.exe",
    "desktop:pack": "npm run backend:build && npm run build && electron-builder --win portable",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node ./scripts/run-vitest.cjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.20.0",
    "docx-preview": "^0.3.2",
    "naive-ui": "^2.40.1",
    "pdfjs-dist": "^4.6.82",
    "vue": "^3.5.13",
    "xlsx": "npm:@e965/xlsx@0.20.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.4",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.requirementatomizer.desktop",
    "productName": "标准需求抽取与审查平台",
    "asar": true,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "signAndEditExecutable": false
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "!dist/win-unpacked/**/*",
      "!dist/*.exe"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": ".",
        "filter": [
          "*.py"
        ]
      },
      {
        "from": "../parsers",
        "to": "parsers"
      },
      {
        "from": "../requirement_kb",
        "to": "requirement_kb"
      },
      {
        "from": "../domain_packs",
        "to": "domain_packs"
      },
      {
        "from": "../knowledge_bases",
        "to": "knowledge_bases"
      },
      {
        "from": "../llm_agents",
        "to": "llm_agents"
      },
      {
        "from": "../dist-backend",
        "to": "backend"
      }
    ]
  }
}
